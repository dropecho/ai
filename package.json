{
  "name": "@dropecho/ai",
  "version": "1.0.0",
  "description": "A set of AI utils for gamedev.",
  "author": "vantreeseba <vantreeseba@gmail.com>",
  "repository": "github:dropecho/ai",
  "type": "module",
  "files": [
    "dist/js/**/*"
  ],
  "main": "./dist/js/cjs/index.cjs",
  "types": "./dist/js/esm/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "scripts": {
    "prepare": "lix download",
    "build": "npm run clean && haxe build.hxml",
    "test": "lix dropecho.testing",
    "clean": "rm -rf dist artifacts",
    "build:docs": "haxelib run dox -i artifacts/docs.xml -o docs/api --toplevel-package dropecho.ai -D source-path https://github.com/dropecho/ai/blob/main/src -D website https://github.com/dropecho/ai --title 'dropecho.ai API'",
    "build:example": "cp dist/js/cjs/index.cjs docs/dropecho.ai.js"
  },
  "devDependencies": {
    "lix": "^16.0.2",
    "@semantic-release/changelog": "^6.0.2",
    "@semantic-release/commit-analyzer": "^9.0.2",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^8.0.7",
    "@semantic-release/npm": "^9.0.1",
    "@semantic-release/release-notes-generator": "^10.0.3",
    "semantic-release": "^19.0.5",
    "semantic-release-haxelib": "^1.1.0"
  },
  "exports": {
    ".": {
      "require": "./dist/js/cjs/index.cjs",
      "import": "./dist/js/esm/index.js"
    }
  }
}
