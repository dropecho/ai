<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the C# that `haxe build.hxml` writes to dist/cs/dropecho.ai/src. Build it with `npm run build`. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>dropecho.ai</AssemblyName>
    <RootNamespace>dropecho.ai</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Warnings in Haxe-generated code. -->
    <NoWarn>$(NoWarn);CS0108;CS0114;CS0162;CS0168;CS0219;CS0414;CS0649;CS0659;CS0660;CS0661;CS1717;CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../dist/cs/dropecho.ai/src/**/*.cs" />
    <!-- The generated code uses `dynamic`. -->
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
  </ItemGroup>
</Project>
